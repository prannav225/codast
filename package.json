{
  "name": "@pra9v/codast",
  "version": "0.1.0",
  "description": "Local-first AI-powered developer CLI for JavaScript, TypeScript, Python, Go, Rust, Java, and Polyglot codebases",
  "type": "module",
  "bin": {
    "codast": "./bin/codast.js",
    "cai": "./bin/codast.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prannav225/codast.git"
  },
  "homepage": "https://github.com/prannav225/codast#readme",
  "bugs": {
    "url": "https://github.com/prannav225/codast/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "test:scanner": "tsx tests/scanner.test.ts",
    "test:ast": "tsx tests/ast-parser.test.ts",
    "test:sqlite": "tsx tests/sqlite.test.ts",
    "test:chunker": "tsx tests/chunker.test.ts",
    "test:vector": "tsx tests/vector.test.ts",
    "test:retrieval": "tsx tests/retrieval.test.ts",
    "test:multi-lang": "tsx tests/multi-lang.test.ts",
    "test": "npm run test:scanner && npm run test:ast && npm run test:sqlite && npm run test:chunker && npm run test:vector && npm run test:retrieval && npm run test:multi-lang",
    "start": "node dist/cli/index.js"
  },
  "keywords": [
    "cli",
    "ai",
    "codast",
    "codebase",
    "polyglot",
    "python",
    "golang",
    "rust",
    "interactive",
    "repl",
    "ast",
    "lancedb",
    "sqlite",
    "voyageai",
    "gemini"
  ],
  "author": "Pranav",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@lancedb/lancedb": "^0.37.1",
    "better-sqlite3": "^11.8.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "ignore": "^5.3.2",
    "ora": "^8.0.1",
    "ts-morph": "^24.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.5.0",
    "tsup": "^8.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
